# Copie este arquivo para ".env" e preencha com os dados do SEU grupo.
# Variáveis com prefixo EXPO_PUBLIC_ são lidas automaticamente pelo Expo
# via process.env.EXPO_PUBLIC_*  (não precisa de biblioteca extra).
#
# ATENÇÃO: nunca commite o .env com a chave real. O .env já está no .gitignore.

# URL base da API da turma (backend NA NUVEM). O padrão já é a nuvem — pode usar assim:
#  - Nuvem (padrão):                 https://api.mockmerce.com.br
#  - (Opcional) rodando o backend na SUA máquina:
#      Emulador Android:             http://10.0.2.2:3333
#      iOS Simulator / web:          http://localhost:3333
#      Celular físico (Expo Go):     http://SEU_IP_NA_REDE:3333   (ex.: http://192.168.0.12:3333)
EXPO_PUBLIC_API_URL=https://api.mockmerce.com.br

# A API Key do grupo (identifica e isola a loja de vocês).
EXPO_PUBLIC_API_KEY=sk_live_troque_pela_chave_do_grupo

# O RM de quem está codando/testando (rastreio — conta na avaliação).
EXPO_PUBLIC_STUDENT_RM=RM000000
